{
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(curl *|sh*)",
      "Bash(curl *|bash*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PROMPT_LOG_MSG=$(bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-log.sh\" 2>/dev/null) bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit.sh\" 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Logging prompts and pushing branch changes"
          }
        ]
      }
    ]
  }
}
