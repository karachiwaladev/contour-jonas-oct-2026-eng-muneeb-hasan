{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PROMPT_LOG_MSG=$(bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-log.sh\" 2>/dev/null) bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-commit.sh\" 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Logging prompts and pushing branch changes"
          }
        ]
      }
    ]
  }
}
